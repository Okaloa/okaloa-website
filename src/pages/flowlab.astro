---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { sanityClient, portableTextToHtml } from '../utils/sanity';

let content = null;

try {
  content = await sanityClient.fetch(`*[_type == "flowlab" && (_id == "flowlab" || _id == "drafts.flowlab")] | order(_updatedAt desc)[0]{
    aboutFlowlabTitle,
    aboutFlowlabSection,
    pricingPhysicalTitle,
    pricingPhysicalSection,
    pricingOnlineTitle,
    pricingOnlineSection
  }`);
} catch (e) {
  console.error("Failed to fetch Flowlab page content from Sanity CMS:", e);
}

const flowlabPage = content || {};

const footerTagline = await sanityClient.fetch(
  `*[_type == "homepage" && (_id == "homepage" || _id == "drafts.homepage")] | order(_updatedAt desc)[0]{ footerTagline }.footerTagline`
).catch(() => null);
---

<Layout
  title="Okaloa Flowlab — Okaloa"
  description="Learn more about Okaloa Flowlab."
  footerTagline={footerTagline}
>
  <!-- Header backdrop (dark strip behind sticky nav only) -->
  <header class="flowlab-hero"></header>

  <!-- About Okaloa Flowlab Section -->
  <SectionBlock
    id="about-flowlab"
    title="About Okaloa Flowlab"
    titleOverride={flowlabPage.aboutFlowlabTitle}
    section={flowlabPage.aboutFlowlabSection}
    bgClass="section-light"
  />

  <!-- Pricing Physical Material Section -->
  <SectionBlock
    id="pricing-physical"
    title="Pricing Physical material"
    titleOverride={flowlabPage.pricingPhysicalTitle}
    section={flowlabPage.pricingPhysicalSection}
    bgClass="section-soft"
  />

  <!-- Pricing Online Version Section -->
  <SectionBlock
    id="pricing-online"
    title="Pricing Online version"
    titleOverride={flowlabPage.pricingOnlineTitle}
    section={flowlabPage.pricingOnlineSection}
    bgClass="section-light"
  />
</Layout>

<style>
  /* Dark backdrop sized to match the sticky nav only — page content below is light */
  .flowlab-hero {
    height: 6.5rem;
    background-color: var(--color-bg-dark-hero);
  }
</style>
