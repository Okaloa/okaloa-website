---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import { sanityClient, portableTextToHtml } from '../utils/sanity';

let content = null;

try {
  content = await sanityClient.fetch(`*[_type == "homepage" && (_id == "homepage" || _id == "drafts.homepage")] | order(_updatedAt desc)[0]{
    heroHeadline,
    heroSection,
    typesOfRiskTitle,
    typesOfRiskSection,
    deriskingTitle,
    deriskingSection,
    engageTitle,
    engageSection,
    whenTitle,
    whenSection,
    workingTitle,
    workingSection,
    eventsSectionText,
    eventsEmptyText,
    events,
    footerTagline
  }`);
} catch (e) {
  console.error("Failed to fetch content from Sanity CMS:", e);
}

const homepage = content || {};

const heroHeadline = homepage.heroHeadline;
const heroSec = homepage.heroSection;
const typesOfRiskSec = homepage.typesOfRiskSection;
const deriskingSec = homepage.deriskingSection;
const engageSec = homepage.engageSection;
const whenSec = homepage.whenSection;
const workingSec = homepage.workingSection;

const eventsSectionText = homepage.eventsSectionText || '';
const eventsEmptyText = homepage.eventsEmptyText || '';
const finalEvents = homepage.events || [];

const footerTagline = homepage.footerTagline || "Helping leaders de-risk strategic initiatives\n\nA good strategy doesn't reliably turn into value. The gap exists because of unaddressed risk. De-risking closes that gap.";
---

<Layout 
  title="Strategic Agility & Flow Simulations" 
  description="Helping leaders de-risk strategic initiatives"
  footerTagline={footerTagline}
>
  
  <!-- Hero / Attention Grabber Section -->
  <header class="hero-section" id="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      {heroHeadline && (
        <h1 class="hero-headline">
          {heroHeadline}
        </h1>
      )}
      
      {/* Hero Section Content Layout: main content stream or legacy text1/image1/text2/image2/text3 */}
      {heroSec && (
        <div class="hero-content-flow">
          <div class="hero-text">
            <Fragment set:html={portableTextToHtml(
              Array.isArray(heroSec) ? heroSec : heroSec.content
            )} />
          </div>
        </div>
      )}

      <div class="scroll-down-container">
        <a href="#types-of-risk" class="scroll-down-btn" aria-label="Scroll to Types of Risk section">
          Discover how
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Types of Risk Section (not in nav) -->
  <SectionBlock
    id="types-of-risk"
    title="The types of risk"
    titleOverride={homepage.typesOfRiskTitle}
    section={typesOfRiskSec}
    bgClass="section-soft"
  />

  <!-- De-risking Section -->
  <SectionBlock
    id="de-risking"
    title="De-risking"
    titleOverride={homepage.deriskingTitle}
    section={deriskingSec}
    bgClass="section-light"
  />

  <!-- How We Engage Section -->
  <SectionBlock
    id="how-we-engage"
    title="How we engage"
    titleOverride={homepage.engageTitle}
    section={engageSec}
    bgClass="section-soft"
  />

  <!-- Is This For You Section -->
  <SectionBlock
    id="is-this-for-you"
    title="Is this for you?"
    titleOverride={homepage.whenTitle}
    section={whenSec}
    bgClass="section-light"
  />

  <!-- In Practice Section -->
  <SectionBlock
    id="in-practice"
    title="In practice"
    titleOverride={homepage.workingTitle}
    section={workingSec}
    bgClass="section-soft"
  />

  <!-- Learn with us Section -->
  <section class="section section-soft" id="learn-with-us">
    <div class="container-narrow">
      <div class="events-header">
        <h2>Learn with us</h2>
        {eventsSectionText && (
          <div class="section-subheader">
            <Fragment set:html={portableTextToHtml(eventsSectionText)} />
          </div>
        )}
      </div>

      {finalEvents.length > 0 ? (
        <div class="grid-2 events-grid">
          {finalEvents.map(event => (
            <div class="card event-card">
              <div class="event-meta">
                <span class="event-date">
                  {new Date(event.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </span>
              </div>
              <h3>{event.title}</h3>
              {event.description && (
                <div class="event-desc">
                  <Fragment set:html={portableTextToHtml(event.description)} />
                </div>
              )}
              {event.link && (
                <a href={event.link} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm event-link" id={`btn-event-${event._key}`}>
                  Register Now &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      ) : eventsEmptyText ? (
        <div class="empty-events">
          <Fragment set:html={portableTextToHtml(eventsEmptyText)} />
        </div>
      ) : null}
    </div>
  </section>
</Layout>

<style>
  .text-center {
    text-align: center;
  }
  
  /* Hero Section Styling */
  .hero-section {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 11rem 2rem 7rem;
    background-color: var(--color-bg-dark-hero);
    overflow: hidden;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(227, 89, 61, 0.12) 0%, rgba(37, 52, 55, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }
  
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--container-narrow-width);
  }
  
  .hero-headline {
    font-size: clamp(2.3rem, 5.2vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-neutral-white);
    margin-bottom: var(--space-md);
  }
  
  .hero-content-flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-text p,
  .hero-text :global(p) {
    font-size: clamp(1.1rem, 1.5vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-neutral-white);
    margin-bottom: 0;
  }

  .hero-image img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border: none !important;
    box-shadow: none !important;
  }
  
  .scroll-down-container {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  .scroll-down-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    background: var(--color-brand-red);
    color: var(--color-neutral-white);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }

  .scroll-down-btn:hover {
    background: var(--color-brand-red-hover);
    transform: translateY(-1px);
  }
  
  /* Events Grid Styling */
  .events-header {
    margin-bottom: var(--space-lg);
  }
  
  .section-subheader {
    font-size: 1.1rem;
    color: var(--color-text-dark-muted);
    margin-top: calc(-1 * var(--space-xs));
    margin-bottom: 0;
  }
  
  .events-grid {
    align-items: stretch;
  }
  
  .event-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }
  
  .event-meta {
    margin-bottom: var(--space-xs);
  }
  
  .event-date {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-brand-red);
    letter-spacing: 0.05em;
  }
  
  .event-card h3 {
    font-size: 1.35rem;
    margin-bottom: var(--space-xs);
  }
  
  .event-desc {
    font-size: 0.98rem;
    flex-grow: 1;
    color: var(--color-text-dark-muted);
    margin-bottom: var(--space-md);
  }
  
  .event-link {
    align-self: flex-start;
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .empty-events p {
    font-size: 1.05rem;
    color: var(--color-text-dark-muted);
    font-style: italic;
  }
</style>
