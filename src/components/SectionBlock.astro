---
import { portableTextToHtml } from '../utils/sanity';

interface Props {
  id: string;
  title: string;
  titleOverride?: string;
  section?: {
    content?: any[];
  };
  bgClass?: string;
  leftColumn?: any[];
  rightColumn?: any[];
  sectionAfterColumns?: {
    content?: any[];
  };
}

const { id, title, titleOverride, section, bgClass = 'section-light', leftColumn, rightColumn, sectionAfterColumns } = Astro.props;
const displayTitle = titleOverride || title;

const content = Array.isArray(section) ? section : section?.content;
const contentAfter = Array.isArray(sectionAfterColumns) ? sectionAfterColumns : sectionAfterColumns?.content;
const hasLeft = Array.isArray(leftColumn) && leftColumn.length > 0;
const hasRight = Array.isArray(rightColumn) && rightColumn.length > 0;
---

<section class={`section ${bgClass}`} id={id}>
  <div class="container-narrow">
    <h2>{displayTitle}</h2>
    <div class="section-content">
      {content && content.length > 0 && (
        <div class="block-text">
          <Fragment set:html={portableTextToHtml(content)} />
        </div>
      )}
      {(hasLeft || hasRight) && (
        <div class="two-columns">
          <div class="block-text">
            {hasLeft && <Fragment set:html={portableTextToHtml(leftColumn)} />}
          </div>
          <div class="block-text">
            {hasRight && <Fragment set:html={portableTextToHtml(rightColumn)} />}
          </div>
        </div>
      )}
      {contentAfter && contentAfter.length > 0 && (
        <div class="block-text block-after-columns">
          <Fragment set:html={portableTextToHtml(contentAfter)} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .block-text :global(p),
  .block-text :global(.block-paragraph) {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-text-dark-muted);
    margin-bottom: 0.5em;
  }

  .block-text :global(p:last-child),
  .block-text :global(.block-paragraph:last-child) {
    margin-bottom: 0;
  }

  .two-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 0.5em;
  }

  .block-after-columns {
    margin-top: 0.5em;
  }

  .two-columns > .block-text {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .two-columns {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
</style>
