---
import { portableTextToHtml } from '../utils/sanity';

interface Props {
  id: string;
  title: string;
  titleOverride?: string;
  section?: {
    content?: any[];
  };
  bgClass?: string;
}

const { id, title, titleOverride, section, bgClass = 'section-light' } = Astro.props;
const displayTitle = titleOverride || title;

const content = Array.isArray(section) ? section : section?.content;
---

<section class={`section ${bgClass}`} id={id}>
  <div class="container-narrow">
    <h2>{displayTitle}</h2>
    <div class="section-content">
      {content && content.length > 0 && (
        <div class="block-text">
          <Fragment set:html={portableTextToHtml(content)} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .block-text :global(p) {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-text-dark-muted);
    margin-bottom: var(--space-sm);
  }

  .block-text :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
